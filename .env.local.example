# URL of the FastAPI backend (no trailing slash).
# Sign-in uses a cookie on the parent domain, so in production this app and the API
# must share one (e.g. app.optimizer.example.com + optimizer.example.com) and the API's
# SESSION_COOKIE_DOMAIN must be set to it (.optimizer.example.com). localhost works as is.
#
# Video uploads also go here: they're resumable (tus) in 32 MB chunks, so each request
# fits under Cloudflare's 100 MB limit and no separate upload host is needed.
NEXT_PUBLIC_API_URL=http://localhost:8000
