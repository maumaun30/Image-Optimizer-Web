# URL of the FastAPI backend (no trailing slash).
# Sign-in uses a cookie on the parent domain, so in production this app, the API and
# the upload host must share one (e.g. app.example.com + api.example.com) and the API's
# SESSION_COOKIE_DOMAIN must be set to it (.example.com). localhost works as is.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Hostname for video uploads only, bypassing any CDN/proxy body-size cap
# (Cloudflare allows 100 MB on Free/Pro). Must reach the origin directly and
# have its own certificate, and sit under the same parent domain as the API.
# Leave unset to send uploads to NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_UPLOAD_URL=https://upload.example.com
